rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isGroupMember(groupId) {
      return isSignedIn() && request.auth.uid in groupData(groupId).memberIds;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn()
        && isGroupMember(resource.data.groupId);
    }

    match /restoreRequests/{docId} {
      allow read, write: if isSignedIn();
    }

    match /groups/{groupId} {
      allow read: if isSignedIn();

      // A space is created with its author as the only member.
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      // Members can edit. A non-member may only add themselves, and only to a
      // shared space that is not yet full.
      allow update: if isSignedIn() && (
        isGroupMember(groupId) || (
          resource.data.isPersonal != true
          && request.auth.uid in request.resource.data.memberIds
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.size() <= resource.data.memberLimit
        )
      );

      allow delete: if isGroupMember(groupId);

      match /rituals/{ritualId} {
        allow read, write: if isGroupMember(groupId);

        match /nudges/{nudgeId} {
          allow read, write: if isGroupMember(groupId);
        }

        // Logs written by older versions of the app, kept readable so they can
        // be migrated into the flat entries collection.
        match /entries/{entryId} {
          allow read, write: if isGroupMember(groupId);
        }
      }

      match /entries/{entryId} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isGroupMember(groupId)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isGroupMember(groupId)
          && resource.data.userId == request.auth.uid;
      }
    }
  }
}
