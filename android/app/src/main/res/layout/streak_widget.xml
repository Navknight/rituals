<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_streak_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_primary"
        android:textSize="34sp"
        android:textStyle="bold"
        android:text="0" />

    <TextView
        android:id="@+id/widget_streak_ritual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Start a streak today" />

    <TextView
        android:id="@+id/widget_streak_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_text_muted"
        android:textSize="12sp"
        android:text="day streak" />

</LinearLayout>
